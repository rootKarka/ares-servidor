# ============================================================================
# ARES server — copia este archivo como `.env` y completa los valores.
#   Windows (PowerShell):  copy .env.example .env
# El archivo `.env` NO se sube a git (está en .gitignore).
# ============================================================================

# --- Servidor ---
PORT=4000
HOST=0.0.0.0
# Orígenes (web) autorizados a llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# --- Base de datos (coincide con docker-compose.yml) ---
DATABASE_URL=postgres://ares:ares_dev_password@localhost:5432/ares

# --- Seguridad ---
# Firma de los tokens de sesión. Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Datos iniciales (npm run db:seed) ---
# Las contraseñas las eliges tú; en la base se guardan cifradas (scrypt).
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@ares.local
SEED_ADMIN_PASSWORD=
# El nombre que aparece en la web: "Hola, <nombre>"
SEED_OPERATOR_NAME=Patrick
SEED_OPERATOR_EMAIL=operador@ares.local
SEED_OPERATOR_PASSWORD=
# Token del robot "delta-force" (el que va en el config.h de las ESP32).
# Si lo dejas vacío, el seed genera uno aleatorio y lo imprime UNA vez.
SEED_ROBOT_TOKEN=

# --- Simulador de robot (npm run sim) ---
SIM_SERVER_URL=ws://localhost:4000/ws/robot
SIM_ROBOT_ID=delta-force
# Debe ser el mismo token de delta-force (SEED_ROBOT_TOKEN).
SIM_ROBOT_TOKEN=
